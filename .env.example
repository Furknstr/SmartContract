# ──────────────────────────────────────────────────────────────────
# Environment Variables — Smart Contract Audit
# ──────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ──────────────────────────────────────────────────────────────────

# PostgreSQL
POSTGRES_USER=audit_user
POSTGRES_PASSWORD=audit_pass
POSTGRES_DB=contract_audit
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://audit_user:audit_pass@localhost:5432/contract_audit

# ChromaDB
CHROMA_HOST=localhost
CHROMA_PORT=8100

# Ollama (runs natively on host)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# LangSmith Tracing (optional — enable for agent flow debugging)
# Old-style LANGCHAIN_* vars (used by langsmith_config.py)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your-langsmith-api-key-here
LANGCHAIN_PROJECT=smart-contract-audit

# New-style LANGSMITH_* vars (used by LangSmith SDK v0.3+)
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your-langsmith-api-key-here
LANGSMITH_PROJECT=smart-contract-audit

